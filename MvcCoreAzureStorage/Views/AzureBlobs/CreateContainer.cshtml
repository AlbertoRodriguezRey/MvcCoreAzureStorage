<h1>
    Create Container
</h1>
<p>
    <a asp-controller="AzureBlobs"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Containers
    </a>
</p>
<form method="post">
    <div class="form-group">
        <label>Container Name</label>
        <input type="text" class="form-control" id="containerName" name="containerName" required>
    </div>
    <button type="submit" class="btn btn-primary">Create Container</button>
</form>

<h2 style="color:red">
    @ViewData["MENSAJE"]
</h2>